    {
      "id": "-mPUiJfpkbPbBjg5gp4qS",
      "type": "text",
      "x": -1197.838921447354,
      "y": 1442.395283944176,
      "width": 668.744814287601,
      "height": 158.52867696597397,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aq",
      "roundness": null,
      "seed": 1098055640,
      "version": 2179,
      "versionNonce": 1318373032,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773259707629,
      "link": null,
      "locked": false,
      "text": "Геймс пре-ген, сокет отправляет в гейм айди блу и айди ред\nкапитанов, гейм генерит запрос к драфту, где говорит гейм тайп,\nкапитанов, и, если надо, прокидывает баннед чемпионов\nДрафт все это хавает, делает оптимизированную функцию,\nкотроая в редис будет прокидывать уведомлялку, сокет сервис\nунарными грпс шлет запросы в драфт",
      "fontSize": 21.13715692879653,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Геймс пре-ген, сокет отправляет в гейм айди блу и айди ред капитанов, гейм генерит запрос к драфту, где говорит гейм тайп, капитанов, и, если надо, прокидывает баннед чемпионов\nДрафт все это хавает, делает оптимизированную функцию, котроая в редис будет прокидывать уведомлялку, сокет сервис унарными грпс шлет запросы в драфт",
      "autoResize": false,
      "lineHeight": 1.25
    },
