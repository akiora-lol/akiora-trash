    {
      "id": "frX_lNkt2flvyqMazbmUS",
      "type": "text",
      "x": -2291.071428571431,
      "y": 247.5000000000001,
      "width": 800.0362811791384,
      "height": 303.8095238095241,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 1960325136,
      "version": 1044,
      "versionNonce": 1283487760,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773233203243,
      "link": null,
      "locked": false,
      "text": "Пользователь тыкает кнопку (начать драфт), сокет прокидывает gRPC в драфт,\nполучает ОК и запускает таймер\nДрафт в инбокс пишет, что запустили драфт\nИспользует редис как хранилище\nВнутри себя держит стейт хранилище, которое  выглядит как кортеж вида:\nЭкшн = (Пик\\бан, команда, айди чампа)\nдрафт имеет тип\nСтейт драфта = (ласт экшн, баннед чампы)\nисходя из этого он возвращает некст экшн, если некст экшна нет, это конец\nдрафта.\nЕсли время просрочилось (31 -32 сек после начала -> рандомный чамп),\nкоторого по запросу можно откатить, если согласна вражеская команда",
      "fontSize": 20.25396825396827,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Пользователь тыкает кнопку (начать драфт), сокет прокидывает gRPC в драфт, получает ОК и запускает таймер\nДрафт в инбокс пишет, что запустили драфт\nИспользует редис как хранилище\nВнутри себя держит стейт хранилище, которое  выглядит как кортеж вида:\nЭкшн = (Пик\\бан, команда, айди чампа)\nдрафт имеет тип\nСтейт драфта = (ласт экшн, баннед чампы)\nисходя из этого он возвращает некст экшн, если некст экшна нет, это конец драфта.\nЕсли время просрочилось (31 -32 сек после начала -> рандомный чамп), которого по запросу можно откатить, если согласна вражеская команда",
      "autoResize": false,
      "lineHeight": 1.25
    }
  ],
