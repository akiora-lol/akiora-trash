# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# RabbitMQ Exchange Configuration
RABBITMQ_EXCHANGE_NAME=chat_exchange
RABBITMQ_EXCHANGE_TYPE=direct
RABBITMQ_EXCHANGE_DURABLE=true

# RabbitMQ Queue Configuration - Input Queue (receive messages)
RABBITMQ_INPUT_QUEUE=chat_messages_input
RABBITMQ_INPUT_ROUTING_KEY=chat.message.new
RABBITMQ_INPUT_QUEUE_DURABLE=true

# RabbitMQ Queue Configuration - Output Queue (publish processed messages)
RABBITMQ_OUTPUT_QUEUE=chat_messages_output
RABBITMQ_OUTPUT_ROUTING_KEY=chat.message.processed
RABBITMQ_OUTPUT_QUEUE_DURABLE=true

# RabbitMQ Queue Configuration - Chat Instance Creation Queue
RABBITMQ_CHAT_INPUT_QUEUE=chat_instance_input
RABBITMQ_CHAT_INPUT_ROUTING_KEY=chat.instance.create
RABBITMQ_CHAT_INPUT_QUEUE_DURABLE=true

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=chat_db

# Application Settings
APP_NAME=ChatService
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Docker Environment Variables
# When running in Docker, use these values:
# RABBITMQ_HOST=rabbitmq
# MONGODB_URL=mongodb://mongodb:27017
